# Copy to .env. Everything is optional: without a key the app runs in mock mode only.
# Keys are read by the server only and are never sent to the browser.

# Anthropic API key, for live Claude runs.
ANTHROPIC_API_KEY=
# Default Claude model (each run records the settings it used).
TRACEPILOT_MODEL=claude-opus-5-5

# Gemini Developer API key (https://aistudio.google.com/apikey): a free development
# stand-in for live runs. GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=
TRACEPILOT_GOOGLE_MODEL=gemini-3.5-flash

# SQLite file location.
TRACEPILOT_DB=data/tracepilot.db

# API server port (the Vite dev server proxies /api here).
PORT=8787
