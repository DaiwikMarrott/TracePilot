# Copy to .env. Everything is optional: without ANTHROPIC_API_KEY the app runs in mock mode only.

# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Default model for live runs (each run records the settings it used).
TRACEPILOT_MODEL=claude-opus-5-5

# SQLite file location.
TRACEPILOT_DB=data/tracepilot.db

# API server port (the Vite dev server proxies /api here).
PORT=8787
